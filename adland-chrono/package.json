{
  "name": "adland-chrono",
  "version": "1.0.0",
  "description": "Chrono — world clock and time lab by AdLand Studio.",
  "author": "AdLand Studio",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "studio.adland.chrono",
    "productName": "Chrono",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/index.html",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Chrono-${version}-Setup.exe"
    },
    "portable": {
      "artifactName": "Chrono-${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chrono"
    }
  }
}