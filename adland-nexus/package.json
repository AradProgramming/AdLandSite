{
  "name":"adland-nexus",
  "version":"1.4.0",
  "description":"AdLand Nexus desktop command center by AdLand Studio.",
  "author":"AdLand Studio",
  "license":"MIT",
  "private":true,
  "main":"electron/main.cjs",
  "scripts":{"dist":"electron-builder --win nsis portable"},
  "devDependencies":{"electron":"latest","electron-builder":"latest"},
  "build":{
    "appId":"studio.adland.nexus",
    "productName":"AdLand Nexus",
    "directories":{"output":"release"},
    "files":["electron/**/*","src/index.html","package.json"],
    "asar":true,
    "compression":"maximum",
    "win":{"icon":"build/icon.svg",
      "target":[
        {"target":"nsis","arch":["x64"]},
        {"target":"portable","arch":["x64"]}
      ],
      "artifactName":"AdLand-Nexus-\u0024{version}-Setup.exe"
    },
    "portable":{"artifactName":"AdLand-Nexus-\u0024{version}-Portable.exe"},
    "nsis":{
      "oneClick":false,
      "allowToChangeInstallationDirectory":true,
      "createDesktopShortcut":true,
      "createStartMenuShortcut":true,
      "shortcutName":"AdLand Nexus"
    }
  }
}